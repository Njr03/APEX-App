# Supabase — only the anon key is safe for client bundling (EXPO_PUBLIC_*).
# NEVER put the service role key in any EXPO_PUBLIC_ variable or client code.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: exact site URL for OAuth redirects on web (no trailing slash).
# Example: http://localhost:8081
# Production PWA example: https://your-domain.com
# EXPO_PUBLIC_SITE_URL=http://localhost:8081
